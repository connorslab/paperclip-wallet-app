#!/usr/bin/env bash
set -euo pipefail
: "${APP_DATA_DIR:?APP_DATA_DIR is required}"
test ! -L "${APP_DATA_DIR}/data"
install -d -m 0700 -o 1000 -g 1000 "${APP_DATA_DIR}/data"
# Optional bundled-Jam candidate volumes are shipped by the package generator.
# Do not change ownership recursively inside an existing funded wallet.
for volume in jam jam-rpc jam-public; do
    if [ -e "${APP_DATA_DIR}/${volume}" ]; then
        test ! -L "${APP_DATA_DIR}/${volume}"
        install -d -m 0700 -o 1000 -g 1000 "${APP_DATA_DIR}/${volume}"
    fi
done
